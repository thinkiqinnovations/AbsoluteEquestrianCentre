# Supabase Session Pooler connection string for deployed environments.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres?pgbouncer=true"

# Supabase direct connection string, used only by Prisma migrations.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Optional for a separately hosted frontend. Leave unset when Express serves the Vite build.
CORS_ORIGIN="https://your-domain.example"
