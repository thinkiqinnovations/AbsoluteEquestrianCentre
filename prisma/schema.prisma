generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RiderLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  PRIVATE
  GROUP
  PART_BOARD_RIDE
  SEMI_PRIVATE
}

enum Discipline {
  FLAT
  JUMP
}

enum LessonStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Horse {
  partBoardAgreements PartBoardAgreement[]
  recurringTemplates RecurringLessonTemplate[]
  id                    String                 @id @default(cuid())
  name                  String
  active                Boolean                @default(true)
  description           String?
  walkCapable           Boolean                @default(true)
  trotCapable           Boolean                @default(true)
  canterCapable         Boolean                @default(false)
  supportsFlat          Boolean                @default(true)
  supportsJumping       Boolean                @default(false)
  minimumRiderLevel     RiderLevel
  maximumRiderLevel     RiderLevel
  maximumDailyRideUnits Decimal                @default(1.5) @db.Decimal(4, 2)
  notes                 String?
  preferences           RiderHorsePreference[]
  lessons               Lesson[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Rider {
  monthlyPaymentStatuses RiderMonthlyPaymentStatus[]
  partBoardAgreements PartBoardAgreement[]
  recurringTemplates RecurringLessonTemplate[]
  id           String                 @id @default(cuid())
  firstName    String
  lastName     String
  active       Boolean                @default(true)
  overallLevel RiderLevel
  flatLevel    RiderLevel
  jumpLevel    RiderLevel
  notes        String?
  preferences  RiderHorsePreference[]
  lessons      Lesson[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model RiderHorsePreference {
  riderId          String
  horseId          String
  preferenceOrder  Int
  notes            String?
  rider            Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
  horse            Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@id([riderId, horseId])
  @@unique([riderId, preferenceOrder])
}

model Coach {
  recurringTemplates RecurringLessonTemplate[]
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  active    Boolean  @default(true)
  notes     String?
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  paymentStatus LessonPaymentStatus?
  id         String       @id @default(cuid())
  date       DateTime     @db.Date
  startTime  String
  endTime    String
  riderId    String
  horseId    String
  coachId    String?
  partBoardAgreementId String?
  consumeEntitlement Boolean @default(false)
  recurringTemplateId String?
  occurrenceDate DateTime? @db.Date
  lessonType LessonType
  discipline Discipline
  rideUnits  Decimal      @db.Decimal(4, 2)
  status     LessonStatus
  notes      String?
  rider      Rider        @relation(fields: [riderId], references: [id])
  horse      Horse        @relation(fields: [horseId], references: [id])
  coach Coach? @relation(fields: [coachId], references: [id], onDelete: Restrict)
  partBoardAgreement PartBoardAgreement? @relation(fields: [partBoardAgreementId], references: [id], onDelete: Restrict)
  recurringTemplate RecurringLessonTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: Restrict)
  entitlementUsage PartBoardEntitlementUsage?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([date, horseId])
  @@index([date, riderId])
  @@index([date, coachId])
  @@unique([recurringTemplateId, occurrenceDate])
}

enum PartBoardAgreementStatus {
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum EntitlementPeriod {
  WEEK
  MONTH
}

enum RecurringTemplateStatus {
  ACTIVE
  PAUSED
  ENDED
}

model PartBoardAgreement {
  id String @id @default(cuid())
  riderId String
  horseId String
  status PartBoardAgreementStatus
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  priority Int @default(100)
  freeRidesPerPeriod Int
  entitlementPeriod EntitlementPeriod
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rider Rider @relation(fields: [riderId], references: [id])
  horse Horse @relation(fields: [horseId], references: [id])
  preferredRideTimes PartBoardPreferredRideTime[]
  entitlementUsages PartBoardEntitlementUsage[]
  recurringTemplates RecurringLessonTemplate[]
  lessons Lesson[]
  @@index([riderId, status])
  @@index([horseId, status])
  @@index([horseId, startDate, endDate])
}

model PartBoardPreferredRideTime {
  id String @id @default(cuid())
  agreementId String
  dayOfWeek DayOfWeek
  startTime String
  endTime String
  preferenceRank Int
  notes String?
  agreement PartBoardAgreement @relation(fields: [agreementId], references: [id])
  @@unique([agreementId, preferenceRank])
}

model PartBoardEntitlementUsage {
  id String @id @default(cuid())
  agreementId String
  lessonId String @unique
  entitlementDate DateTime @db.Date
  quantity Int @default(1)
  reversedAt DateTime?
  createdAt DateTime @default(now())
  agreement PartBoardAgreement @relation(fields: [agreementId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])
  @@index([agreementId, entitlementDate])
}

model RecurringLessonTemplate {
  id String @id @default(cuid())
  riderId String
  horseId String
  coachId String?
  partBoardAgreementId String?
  dayOfWeek DayOfWeek
  startTime String
  endTime String
  lessonType LessonType
  discipline Discipline
  rideUnits Decimal @db.Decimal(4, 2)
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  status RecurringTemplateStatus
  schedulingPriority Int
  consumeEntitlement Boolean @default(false)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rider Rider @relation(fields: [riderId], references: [id])
  horse Horse @relation(fields: [horseId], references: [id])
  coach Coach? @relation(fields: [coachId], references: [id], onDelete: Restrict)
  partBoardAgreement PartBoardAgreement? @relation(fields: [partBoardAgreementId], references: [id], onDelete: Restrict)
  lessons Lesson[]
  @@index([status, startDate, endDate])
}

enum AvailabilityResourceType {
  RIDER
  COACH
  HORSE
}

enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AvailabilityRule {
  id String @id @default(cuid())
  resourceType AvailabilityResourceType
  resourceId String
  dayOfWeek DayOfWeek
  startTime String
  endTime String
  availabilityType AvailabilityType
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceType, resourceId, dayOfWeek])
}

model AvailabilityOverride {
  id String @id @default(cuid())
  resourceType AvailabilityResourceType
  resourceId String
  date DateTime @db.Date
  startTime String
  endTime String
  availabilityType AvailabilityType
  notes String?
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceType, resourceId, date])
}

enum RecordedPaymentStatus {
  PAID
  UNPAID
  UNRECORDED
}

enum MonthlyPaymentKind {
  MONTHLY
  PART_BOARD
}

model LessonPaymentStatus {
  lessonId  String                @id
  status    RecordedPaymentStatus
  updatedAt DateTime              @updatedAt
  lesson    Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model RiderMonthlyPaymentStatus {
  riderId   String
  month     String
  kind      MonthlyPaymentKind
  status    RecordedPaymentStatus
  updatedAt DateTime              @updatedAt
  rider     Rider                 @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@id([riderId, month, kind])
  @@index([month])
}
